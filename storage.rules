rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Avatar storage rules: strictly confined to user's own directory
    match /users/{userId}/avatar/{fileName} {
      // Allow read for public community avatars
      allow read: if true;
      
      // Allow write and update only by the authenticated owner, restricted to valid image types under 5MB
      allow write: if isOwner(userId)
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/(jpeg|png|webp)');

      // Allow deletion by the owner
      allow delete: if isOwner(userId);
    }
  }
}
